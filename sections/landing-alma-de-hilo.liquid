<title>Alma de Hilo</title>
<meta name="claude:viewport-fit-sides" content="cover">
<!--
  LANDING ALMA DE HILO · "1000 Patrones de Macramé" · para pegar en Shopify
  Dónde pegarla: Tienda online > Temas > Personalizar > sección "Liquid personalizado". Pegá TODO el archivo
  (podés borrar las dos primeras líneas, <title> y <meta>).

  QUÉ COMPLETAR:
  1) El bloque CONFIG del <script> al final: logo, links de pago, videos, contacto.
  2) Todo lo que aparece entre [CORCHETES] y resaltado.
  3) Los recuadros punteados [FOTO: ...] -> reemplazalos por <img src="URL" alt="descripción">.

  REGLAS DE MARCA (identidad aprobada para desarrollo web):
  - El logo NO está dibujado acá: se carga el archivo final (CONFIG.logoHorizontalUrl), versión horizontal
    sin tagline. Espacio libre alrededor = altura de la "A".
  - Isotipo solo en avatar y favicon (Shopify > Personalizar > Configuración del tema > Favicon).
  - Todas las esquinas redondeadas a 5px.

  OFERTA DE LANZAMIENTO:
  - Cada visitante tiene CONFIG.minutosOferta minutos para comprar a precio de lanzamiento. El tiempo se guarda
    en su navegador: si recarga la página NO se reinicia. Cuando llega a cero, la página muestra el precio normal
    y el botón usa CONFIG.linkDePagoNormal. Así la cuenta regresiva es verdadera.
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: columna única para celular (máx. 640px), boutique creativa: crema dominante, bandas nude, rótulos espaciados
   con filete fino, cajas de 5px. Las llamadas a la acción son el único elemento en rosa profundo. */
:root{
  --adh-crema:#FFF9F2;      /* fondo principal (marca) */
  --adh-papel:#FFFDFA;      /* cajas sobre crema */
  --adh-nude:#EBD6D0;       /* bandas (marca) */
  --adh-nude-suave:#F6EAE5; /* cajas y franjas */
  --adh-rosa:#C98283;       /* acento decorativo (marca) */
  --adh-rosa-texto:#B86F72; /* rosa para números grandes: 3,6:1 sobre crema */
  --adh-rosa-boton:#A85E61; /* botón: texto blanco 4,7:1 */
  --adh-rosa-hover:#94505A;
  --adh-arcilla:#B97C69;    /* líneas (marca) */
  --adh-topo:#755D58;       /* texto sobre crema (marca) */
  --adh-topo-osc:#5E4844;   /* titulares y texto sobre nude */
  --adh-linea:#E4D4CD;      /* filetes finos */
  --adh-marca:#F3E3C3;      /* resaltado de lo que falta completar */
  --adh-radio:5px;
  --adh-beige:#F6EDE2;      /* beige derivado de crema + arcilla, final del degradado */
  --adh-degradado:linear-gradient(145deg,var(--adh-nude) 0%,#F2E3DB 45%,var(--adh-beige) 100%); /* fondo de cajas: rosa nude a beige */
  --adh-display:"Cormorant Garamond", "Garamond", Georgia, serif;
  --adh-body:"DM Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  color-scheme:light;
}
body{background:var(--adh-crema);color:var(--adh-topo)}
.adh{font-family:var(--adh-body);font-size:17px;line-height:1.65;color:var(--adh-topo);background:var(--adh-crema);overflow-x:hidden}
.adh *{box-sizing:border-box}
.adh [hidden]{display:none !important}
.adh img{max-width:100%;height:auto;display:block}
.adh h1,.adh h2,.adh h3{font-family:var(--adh-display);font-weight:600;line-height:1.1;text-wrap:balance;margin:0;color:var(--adh-topo-osc)}
.adh h2{font-size:clamp(2rem,7.5vw,2.75rem);font-weight:500}
.adh h3{font-size:1.4rem}
.adh p{margin:0}
.adh ul,.adh ol{margin:0;padding:0;list-style:none}
.adh a{color:var(--adh-rosa-boton)}
.adh :focus-visible{outline:2px solid var(--adh-topo-osc);outline-offset:3px;border-radius:var(--adh-radio)}
.adh-skip{position:absolute;left:-9999px;top:8px;z-index:100;background:var(--adh-topo-osc);color:var(--adh-crema) !important;padding:12px 18px;border-radius:var(--adh-radio);font-weight:600}
.adh-skip:focus{left:16px}

/* contenedor y bandas */
.adh-band{padding-block:64px}
.adh-band--nude{background:var(--adh-nude);color:var(--adh-topo-osc)}
.adh-band--suave{background:var(--adh-nude-suave);color:var(--adh-topo-osc)}
.adh-wrap{max-width:640px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:22px}
.adh-centro{text-align:center;align-items:center}

/* rótulo con filete, lenguaje del brandboard */
.adh-label{display:flex;align-items:center;gap:14px;font-size:.8rem;font-weight:500;letter-spacing:.18em;color:var(--adh-topo);width:100%}
.adh-label::after{content:"";flex:1;height:1px;background:var(--adh-linea)}
.adh-centro .adh-label::before{content:"";flex:1;height:1px;background:var(--adh-linea)}
.adh-band--nude .adh-label{color:var(--adh-topo-osc)}
.adh-band--nude .adh-label::after,.adh-band--nude .adh-label::before{background:var(--adh-arcilla);opacity:.5}
.adh-lead{font-size:1.08rem}
.adh-nota{font-family:var(--adh-display);font-style:italic;font-size:1.35rem;line-height:1.35;color:var(--adh-topo-osc)}

/* placeholders */
.adh .ph{background:var(--adh-marca);color:var(--adh-topo-osc);padding:0 .25em;border-radius:3px;font-weight:500;font-style:normal}
.adh-foto{border:1.5px dashed var(--adh-arcilla);border-radius:var(--adh-radio);background:var(--adh-nude-suave);color:var(--adh-topo-osc);display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;font-size:.9rem;aspect-ratio:4/3;max-width:100%;width:100%}
.adh-foto--portada{aspect-ratio:3/4;max-width:230px;margin:0 auto}
.adh-foto--cuadrada{aspect-ratio:1/1}
.adh-video{display:block;width:100%;max-width:300px;max-height:80vh;margin:0 auto;border-radius:var(--adh-radio);background:var(--adh-nude-suave);object-fit:cover}
.adh-video--portada{max-width:230px;aspect-ratio:3/4}
.adh-logo{display:inline-block;padding:14px}  /* espacio libre ≈ altura de la "A" del logo de 44px */
.adh-logo-slot{display:inline-block;border:1.5px dashed var(--adh-arcilla);border-radius:var(--adh-radio);color:var(--adh-topo);font-size:.78rem;letter-spacing:.08em;padding:8px 14px;text-align:center}

/* botón premium: sólido, filo de luz interior, flecha que avanza al pasar */
.adh-btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;width:100%;max-width:440px;min-height:58px;padding:16px 28px;border-radius:var(--adh-radio);background:var(--adh-rosa-boton);color:#FFFFFF !important;text-decoration:none;font-family:var(--adh-body);font-weight:500;font-size:1.05rem;letter-spacing:.05em;text-align:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 12px 26px -14px rgba(94,72,68,.7);transition:background-color .25s ease-out,box-shadow .25s ease-out,transform .25s ease-out}
.adh-btn svg{width:18px;height:18px;flex:0 0 auto;transition:transform .2s ease-out}
.adh-btn:hover{background:var(--adh-rosa-hover);box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 16px 30px -14px rgba(94,72,68,.8);transform:translateY(-1px)}
.adh-btn:hover svg,.adh-btn:focus-visible svg{transform:translateX(4px) scale(1.1)}
.adh-btn:active{transform:translateY(0)}
.adh-micro{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 18px;font-size:.86rem;color:var(--adh-topo)}
.adh-band--nude .adh-micro,.adh-band--suave .adh-micro{color:var(--adh-topo-osc)}

/* cabecera: logo a la izquierda, llamada al 50% a la derecha */
.adh-head{border-bottom:1px solid var(--adh-linea);padding-block:4px;background:var(--adh-crema)}
.adh-head .adh-wrap{flex-direction:row;align-items:center;justify-content:space-between;gap:10px}
.adh-head .adh-logo{padding:12px 12px 12px 0}
.adh-head .adh-logo img{height:40px;width:auto}
.adh-head-cta{display:inline-flex;align-items:center;gap:8px;background:var(--adh-topo-osc);color:var(--adh-crema) !important;text-decoration:none;border-radius:var(--adh-radio);padding:10px 14px;font-size:.84rem;font-weight:600;letter-spacing:.03em;white-space:nowrap;box-shadow:inset 0 1px 0 rgba(255,255,255,.14);transition:background-color .25s ease-out}
.adh-head-cta:hover{background:#4A3532}
.adh-head-cta svg{width:15px;height:15px;transition:transform .2s ease-out}
.adh-head-cta:hover svg{transform:translateX(3px) scale(1.1)}
@media (max-width:380px){.adh-head .adh-logo img{height:32px}.adh-head-cta{padding:9px 11px;font-size:.78rem}}

/* frases con ovillo de separador */
.adh-micro--ovillo{align-items:center;gap:10px;font-size:.95rem;font-weight:500;color:var(--adh-topo-osc)}
.adh-ovillo{width:14px;height:14px;flex:0 0 auto}
.adh-ovillo .o-bola{fill:var(--adh-rosa)}
.adh-ovillo .o-hebra{fill:none;stroke:var(--adh-crema);stroke-width:.9;stroke-linecap:round}
.adh-ovillo .o-cola{fill:none;stroke:var(--adh-rosa);stroke-width:1;stroke-linecap:round}

/* imágenes reales */
.adh-imagen{width:100%;border-radius:var(--adh-radio);object-fit:cover;background:var(--adh-nude-suave)}
.adh-imagen--cuadrada{aspect-ratio:1/1}
.adh-imagen--ancha{aspect-ratio:4/3}
.adh-portada{width:100%;max-width:240px;height:auto;margin:0 auto;filter:drop-shadow(0 14px 22px rgba(94,72,68,.25))}

/* reseñas reales con foto de la pieza */
.adh-resenas{display:grid;gap:12px;width:100%}
.adh-resena{margin:0;background:var(--adh-degradado);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);padding:14px;display:grid;gap:14px;text-align:left}
.adh-resena img{width:100%;height:auto;border-radius:var(--adh-radio)}
.adh-resena--ig{display:grid;grid-template-columns:1fr;padding:10px;gap:10px}
.adh-resena--ig img{border:0}
.adh-resena blockquote{margin:0;font-family:var(--adh-display);font-style:italic;font-size:1.3rem;line-height:1.3;color:var(--adh-topo-osc)}
.adh-resena figcaption{font-size:.84rem;color:var(--adh-topo-osc)}
@media (min-width:560px){.adh-resena{grid-template-columns:200px 1fr;align-items:center}}

/* hero */
.adh-hero{padding-block:40px 56px}
.adh-para{font-size:.8rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--adh-rosa-boton);max-width:32ch}
.adh-hero h1{font-size:clamp(2.4rem,10vw,3.8rem);line-height:1.04;max-width:16ch}
.adh-hero h1 em{font-style:italic;font-weight:500;color:var(--adh-rosa-texto)}
.adh-hero .adh-lead{max-width:38ch}

/* franja de prueba */
.adh-prueba{border-block:1px solid var(--adh-linea);padding-block:30px;background:var(--adh-papel)}
.adh-prueba blockquote{margin:0;font-family:var(--adh-display);font-style:italic;font-size:1.55rem;line-height:1.3;color:var(--adh-topo-osc)}
.adh-prueba figcaption{font-size:.86rem;margin-top:8px}

/* sección 2: situaciones en cajas */
.adh-cajas{display:flex;flex-direction:column;gap:10px;width:100%}
.adh-cajas li{background:var(--adh-degradado);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);padding:16px 18px;font-size:1.02rem;color:var(--adh-topo-osc)}
.adh-remate{font-family:var(--adh-display);font-style:italic;font-size:1.45rem;line-height:1.3;color:var(--adh-topo-osc)}

/* sección 4: cuatro logros */
.adh-logros{display:grid;gap:12px}
.adh-logro{background:var(--adh-degradado);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);padding:20px;display:flex;flex-direction:column;gap:6px}
.adh-logro small{font-size:.74rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--adh-rosa-boton)}
.adh-logro p{font-size:.97rem}
.adh-siete{font-family:var(--adh-display);font-weight:500;font-size:clamp(4.5rem,24vw,7rem);line-height:.85;color:var(--adh-rosa-texto)}

/* galería */
.adh-galeria{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%}
.adh-galeria figure{margin:0;display:flex;flex-direction:column;gap:6px;min-width:0}
.adh-galeria figcaption{font-size:.84rem;text-align:center}

/* oferta de lanzamiento */
.adh-oferta{background:var(--adh-degradado);border:1px solid var(--adh-arcilla);border-radius:var(--adh-radio);padding:30px 20px;display:flex;flex-direction:column;align-items:center;gap:20px;color:var(--adh-topo);text-align:center;width:100%}
.adh-badge{display:inline-block;background:var(--adh-rosa-boton);color:#FFFFFF;border-radius:var(--adh-radio);padding:6px 14px;font-size:.82rem;font-weight:600;letter-spacing:.12em}
.adh-oferta-mil{display:flex;flex-direction:column;align-items:center}
.adh-oferta-mil b{font-family:var(--adh-display);font-weight:500;font-size:clamp(5rem,26vw,6.5rem);line-height:.88;color:var(--adh-rosa-texto)}
.adh-oferta-mil span{font-family:var(--adh-display);font-weight:600;font-size:1.7rem;color:var(--adh-topo-osc)}
.adh-oferta-lista{width:100%;text-align:left}
.adh-oferta-lista li{display:flex;gap:10px;padding-block:9px;border-top:1px solid var(--adh-linea);font-size:.97rem}
.adh-oferta-lista li::before{content:"✓";color:var(--adh-rosa-boton);font-weight:600}
/* pop-up de upsells: se abre al tocar cualquier botón de compra, antes de ir al pago.
   En el celular sube desde abajo; en computadora queda centrado. */
.adh-pop{width:100%;max-width:480px;max-height:92vh;max-height:92dvh;margin:auto auto 0;padding:0;border:0;border-radius:14px 14px 0 0;background:var(--adh-crema);color:var(--adh-topo);font-family:var(--adh-body);font-size:17px;line-height:1.55;box-shadow:0 -20px 50px -20px rgba(94,72,68,.6);overflow:auto;overscroll-behavior:contain}
.adh-pop::backdrop{background:rgba(70,52,48,.55)}
.adh-pop[open]{animation:adh-sube .3s ease-out}
@keyframes adh-sube{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@media (min-width:640px){.adh-pop{margin:auto;border-radius:var(--adh-radio)}}
@media (prefers-reduced-motion:reduce){.adh-pop[open]{animation:none}}
.adh-pop p{margin:0}
.adh-pop-in:focus{outline:none}
.adh-pop-in{display:flex;flex-direction:column;gap:16px;padding:22px 20px calc(20px + env(safe-area-inset-bottom,0px))}
.adh-pop-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.adh-pop-head > div{display:flex;flex-direction:column;gap:8px;min-width:0}
.adh .adh-pop h2{font-size:1.85rem}
.adh-pop-x{flex:0 0 auto;width:42px;height:42px;border:1px solid var(--adh-linea);border-radius:50%;background:var(--adh-papel);color:var(--adh-topo-osc);font-size:1.5rem;line-height:1;cursor:pointer}
.adh-pop-pedido{display:flex;justify-content:space-between;gap:12px;align-items:center;background:var(--adh-papel);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);padding:12px 14px;font-size:.9rem;line-height:1.35;color:var(--adh-topo-osc)}
.adh-pop-pedido b{font-family:var(--adh-display);font-size:1.35rem;white-space:nowrap;font-variant-numeric:lining-nums}
.adh-up{display:grid;grid-template-columns:76px 1fr;gap:14px;align-items:start;background:var(--adh-degradado);border:1.5px dashed var(--adh-rosa-boton);border-radius:var(--adh-radio);padding:14px;transition:border-color .2s ease-out}
.adh-up.is-on{border-style:solid}
.adh-up img{width:76px;height:auto;border-radius:var(--adh-radio);box-shadow:0 8px 14px -10px rgba(94,72,68,.7)}
.adh-up-txt{display:flex;flex-direction:column;gap:6px;min-width:0}
.adh-up-tag{font-size:.68rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--adh-rosa-boton)}
.adh .adh-up h3{font-size:1.3rem}
.adh-up-txt p{font-size:.86rem;line-height:1.45}
.adh-up-precio{display:flex;align-items:baseline;gap:8px}
.adh-up-precio b{font-family:var(--adh-display);font-size:1.55rem;color:var(--adh-rosa-boton);font-variant-numeric:lining-nums}
.adh-up-precio s{font-size:.9rem}
.adh-up-btn{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 18px;border:1.5px solid var(--adh-rosa-boton);border-radius:var(--adh-radio);background:#FFFFFF;color:var(--adh-rosa-boton);font:600 .95rem/1 var(--adh-body);cursor:pointer;transition:background-color .2s ease-out,color .2s ease-out}
.adh-up-btn[aria-pressed="true"]{background:var(--adh-rosa-boton);color:#FFFFFF}
.adh-pop-total{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--adh-linea);padding-top:12px;color:var(--adh-topo-osc)}
.adh-pop-total b{font-family:var(--adh-display);font-size:2rem;font-variant-numeric:lining-nums}
.adh-pop .adh-btn{max-width:none;align-self:stretch}
.adh-pop-micro{font-size:.8rem;text-align:center}
.adh-precio{display:flex;flex-direction:column;gap:2px;align-items:center}
.adh-precio-antes{text-decoration:line-through;font-size:1.25rem;font-weight:500}
.adh-precio-num{font-family:var(--adh-display);font-weight:700;font-size:4.3rem;-webkit-text-stroke:1.5px currentColor;line-height:1.05;color:var(--adh-topo-osc);font-variant-numeric:tabular-nums lining-nums}
.adh-precio-nota{font-size:.88rem}
.adh-reloj-box{width:100%;background:var(--adh-papel);border-radius:var(--adh-radio);padding:14px 16px;display:flex;flex-direction:column;gap:2px;color:var(--adh-topo-osc)}
.adh-reloj-box span{font-size:.9rem}
.adh-reloj-box .adh-reloj{font-family:var(--adh-display);font-weight:600;font-size:2.6rem;line-height:1.1;font-variant-numeric:tabular-nums lining-nums;letter-spacing:.04em}
.adh-pasos{display:grid;gap:12px;counter-reset:paso;width:100%;text-align:left}
.adh-pasos li{display:grid;grid-template-columns:30px 1fr;gap:12px;align-items:start;font-size:.94rem}
.adh-pasos li::before{counter-increment:paso;content:counter(paso);width:30px;height:30px;border-radius:50%;border:1px solid var(--adh-arcilla);color:var(--adh-topo-osc);display:flex;align-items:center;justify-content:center;font-family:var(--adh-display);font-weight:600;font-size:1.05rem}

/* lector de patrón */
.adh-patron{background:var(--adh-papel);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);overflow:hidden}
.adh-patron-head{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--adh-linea);font-size:.8rem;letter-spacing:.06em}
.adh-filas{padding:10px 8px;display:flex;flex-direction:column;gap:2px;font-size:.95rem}
.adh-fila{display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding:6px 8px}
.adh-fila-n{font-family:var(--adh-display);font-size:1.15rem;font-weight:600;color:var(--adh-topo-osc);margin-right:2px}
.adh-tok{font:inherit;border:1px solid var(--adh-linea);background:var(--adh-crema);color:var(--adh-topo-osc);border-radius:var(--adh-radio);padding:4px 12px;cursor:pointer;min-height:36px}
.adh-tok:hover{border-color:var(--adh-rosa)}
.adh-tok[aria-pressed="true"]{background:var(--adh-rosa-boton);border-color:var(--adh-rosa-boton);color:#FFFFFF}
.adh-tok--cuenta{border-style:dashed;border-color:var(--adh-arcilla)}
.adh-explica{margin:0 8px 8px;background:var(--adh-nude-suave);border-radius:var(--adh-radio);padding:14px 16px;min-height:118px;display:flex;flex-direction:column;gap:4px;color:var(--adh-topo-osc)}
.adh-explica b{font-family:var(--adh-display);font-size:1.25rem;font-weight:600}

/* incluye */
.adh-chips{display:flex;flex-wrap:wrap;gap:8px}
.adh-chips span{border:1px solid var(--adh-topo);border-radius:var(--adh-radio);padding:4px 14px;font-size:.86rem}
.adh-incluye{display:grid;gap:12px}
.adh-incluye li{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start;background:var(--adh-degradado);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);padding:18px}
.adh-incluye .adh-n{font-family:var(--adh-display);font-size:1.35rem;font-weight:600;color:var(--adh-arcilla);min-width:28px}
.adh-incluye div{min-width:0}
.adh-incluye strong{display:block;font-weight:500;color:var(--adh-topo-osc)}
.adh-incluye p{font-size:.94rem}

/* testimonios */
.adh-testis{display:flex;flex-direction:column;gap:12px}
.adh-testi{background:var(--adh-degradado);border:1px solid var(--adh-linea);border-radius:var(--adh-radio);padding:20px;margin:0;display:flex;flex-direction:column;gap:10px;color:var(--adh-topo)}
.adh-testi blockquote{margin:0;font-size:1rem}
.adh-testi figcaption{font-size:.84rem}
