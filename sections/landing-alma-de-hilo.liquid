  <!-- CONTACTO -->
  <section class="adh-band adh-band--nude" id="contacto">
    <div class="adh-wrap">
      <p class="adh-label">Contacto</p>
      <h2>¿Tenés una duda? Escribime</h2>
      <ul class="adh-contacto">
        <li><b>Mail</b><span data-adh="email">almadehilo12@gmail.com</span></li>
        <li><b>Instagram</b><span data-adh="instagram">@alma.dehiloo</span></li>
      </ul>
    </div>
  </section>

  <footer class="adh-footer">
    <div class="adh-wrap">
      <span class="adh-logo"><img src="https://cdn.shopify.com/s/files/1/1101/8210/5374/files/alma-logo-horizontal-transparente_7484946f-dbdd-44db-8393-625cf834628b.png?v=1793328115" data-local="web/logo-horizontal.png" onerror="if(this.dataset.local&&this.src.indexOf(this.dataset.local)<0)this.src=this.dataset.local" alt="Alma de Hilo" width="130" height="44" style="height:44px;width:auto;margin:0 auto"></span>
      <p class="adh-tagline">Creá con tus manos</p>
      <nav><a href="#">Términos y condiciones</a><a href="#">Política de devoluciones</a><a href="#">Privacidad</a></nav>
      <p>Alma de Hilo · <span class="ph">[Razón social o nombre · CUIT]</span> · Producto digital.</p>
    </div>
  </footer>

  <!-- POP-UP DE UPSELLS: se abre al tocar cualquier botón de compra, antes de ir al pago.
       Para sumar o sacar ofertas, editá la lista de abajo (handles de productos separados por coma).
       Solo se muestran los productos activos; si no queda ninguno, los botones van directo al pago.
       Imagen: la del producto en Shopify o, si no tiene, assets/upsell-HANDLE.jpg -->
  {%- assign adh_upsell_handles = 'guia-de-hilos-para-macrame' | split: ',' -%}
  <dialog class="adh-pop" id="adh-pop" aria-labelledby="adh-pop-titulo">
    <div class="adh-pop-in" tabindex="-1" autofocus>
      <div class="adh-pop-head">
        <div>
          <p class="adh-label">Antes de pagar</p>
          <h2 id="adh-pop-titulo">Sumá algo más a tu pedido</h2>
        </div>
        <button type="button" class="adh-pop-x" data-pop-cerrar aria-label="Cerrar">×</button>
      </div>
      <div class="adh-pop-pedido"><span>1000 Patrones de Macramé + 7 ebooks de regalo</span><b id="adh-pop-base">$19.990</b></div>
      {%- for adh_h in adh_upsell_handles -%}
        {%- assign adh_handle = adh_h | strip -%}
        {%- assign adh_up = all_products[adh_handle] -%}
        {%- if adh_up and adh_up.available -%}
      <div class="adh-up" data-up data-variante="{{ adh_up.selected_or_first_available_variant.id }}" data-precio="{{ adh_up.price | divided_by: 100 }}">
        {%- if adh_up.featured_image -%}
        <img src="{{ adh_up.featured_image | image_url: width: 220 }}" alt="{{ adh_up.title | escape }}" width="76" loading="lazy">
        {%- else -%}
        <img src="{{ 'upsell-' | append: adh_handle | append: '.jpg' | asset_url }}" alt="{{ adh_up.title | escape }}" width="76" loading="lazy">
        {%- endif -%}
        <div class="adh-up-txt">
          <span class="adh-up-tag">Solo con esta compra</span>
          <h3>{{ adh_up.title }}</h3>
          <p>{{ adh_up.description | strip_html | split: '. ' | first | strip }}.</p>
          <div class="adh-up-precio"><b>{{ adh_up.price | money_without_trailing_zeros }}</b>{% if adh_up.compare_at_price > adh_up.price %}<s>{{ adh_up.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}</div>
          <button type="button" class="adh-up-btn" aria-pressed="false" data-up-btn>+ Agregar</button>
        </div>
      </div>
        {%- endif -%}
      {%- endfor -%}
      <div class="adh-pop-total"><span>Total</span><b id="adh-pop-total">$19.990</b></div>
      <a class="adh-btn" id="adh-pop-pagar" href="#oferta"><span id="adh-pop-pagar-txt">Ir a pagar $19.990</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
      <p class="adh-pop-micro">🔒 Pago seguro procesado por Shopify</p>
    </div>
  </dialog>

  <!-- Botón flotante tipo píldora: siempre visible, con el precio -->
  <a class="adh-fija" id="adh-fija" href="#oferta" data-pay>
    <span class="adh-fija-precio"><b id="adh-fija-precio">$19.990</b><small id="adh-fija-txt">Termina en 10:00</small><small class="adh-fija-regalo">🎁 + 7 ebooks de regalo</small></span>
    <span class="adh-fija-cta">Obtener ahora<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
  </a>
</div>

<script>
(function(){
  /* ====== CONFIG ====== */
  var CONFIG = {
    logoHorizontalUrl: "",           // URL del logo horizontal SIN tagline, exportación final transparente.
    precioNormal: "$39.990",
    precioLanzamiento: "$19.990",
    descuento: "50% OFF",
    minutosOferta: 10,               // minutos por visitante; no se reinicia al recargar
    // Links de compra de Shopify: llevan directo al pago. El producto tiene que estar ACTIVO (hoy está en borrador hasta cargar el PDF).
    linkDePago: "https://almadehilo.myshopify.com/cart/60886313500958:1",   // $19.990 · paquete (bundle): ebook + 7 bonus; el checkout muestra los 8
    linkDePagoNormal: "https://almadehilo.myshopify.com/cart/60886313500958:1",                    // $39.990 (cuando termina el tiempo)
    medioPago: "",                   // ej. "Mercado Pago"
    formato: "",                     // ej. "PDF"
    entrega: "Descarga inmediata",
    garantiaDias: "",                // SOLO si hay garantía real, ej. "7". Vacío = no se muestra.
    videoPortadaUrl: "https://cdn.shopify.com/videos/c/vp/f418797fc8b84999a5465283fdb53689/f418797fc8b84999a5465283fdb53689.HD-720p-4.5Mbps-99397307.mp4",
    videoPorDentroUrl: "https://cdn.shopify.com/videos/c/vp/5c2d959d764e4c87bfad6a5667013baa/5c2d959d764e4c87bfad6a5667013baa.HD-720p-4.5Mbps-99397308.mp4", // pordentro.mp4: compartir como "cualquier persona con el enlace"
    email: "almadehilo12@gmail.com",
    instagram: "@alma.dehiloo",
    navidadHasta: "2026-12-26T00:00:00-03:00" // fin de la decoración navideña (medianoche del 25, hora Argentina). Vacío = sin Navidad.
  };
  /* ==================== */

  var root = document.querySelector(".adh");
  var navidad = !!CONFIG.navidadHasta && Date.now() < new Date(CONFIG.navidadHasta).getTime();
  if (navidad) {
    root.classList.add("adh--navidad");
    // Moño dorado sobre la cinta de cada botón (todos son "regalos").
    root.querySelectorAll(".adh-btn, .adh-head-cta, .adh-fija-cta").forEach(function(b){
      b.insertAdjacentHTML("beforeend", '<svg class="adh-mono" viewBox="0 0 32 24" aria-hidden="true"><path class="m-cola" d="M15 12 10.5 21.5M17 12l4.5 9.5"/><path class="m-lazo" d="M16 11C10.5 2.5 3.5 3 4 8.5s7.5 4.5 12 2.5ZM16 11c5.5-8.5 12.5-8 12-2.5s-7.5 4.5-12 2.5Z"/><circle class="m-nudo" cx="16" cy="11" r="2.8"/></svg>');
    });
  }
  root.querySelectorAll("[data-adh]").forEach(function(el){
    var v = CONFIG[el.getAttribute("data-adh")];
    if (v) el.textContent = v;
  });
  root.querySelectorAll("[data-adh-si]").forEach(function(el){
    el.hidden = !CONFIG[el.getAttribute("data-adh-si")];
  });

  // Logo: archivo final, sin redibujar.
  root.querySelectorAll("[data-adh-logo]").forEach(function(slot){
    var url = CONFIG[slot.getAttribute("data-adh-logo")];
    if (!url) return;
    var img = new Image();
    img.src = url; img.alt = slot.getAttribute("data-alt") || "";
    img.style.height = "44px"; img.style.width = "auto"; img.style.margin = "0 auto";
    slot.innerHTML = ""; slot.appendChild(img);
  });

  // Videos: reemplazan su recuadro cuando hay link.
  root.querySelectorAll("[data-adh-video]").forEach(function(slot){
    var url = CONFIG[slot.getAttribute("data-adh-video")];
    if (!url) return;
    var v = document.createElement("video");
    // Sin controles: se reproduce solo, mudo y en bucle (el celular solo permite autoplay con el video mudo).
    v.src = url; v.controls = false; v.loop = true; v.muted = true; v.autoplay = true; v.playsInline = true; v.preload = "auto";
    v.setAttribute("muted", ""); v.setAttribute("playsinline", ""); v.setAttribute("disablepictureinpicture", "");
    v.setAttribute("aria-label", "Video de muestra, sin sonido");
    v.className = slot.getAttribute("data-video-class") || "adh-video";
    slot.replaceWith(v);
    var p = v.play(); if (p && p.catch) p.catch(function(){});
  });

  // Oferta de lanzamiento: ventana real de N minutos por visitante.
  var KEY = "adh-lanzamiento-fin";
  var fin = null;
  try { fin = parseInt(localStorage.getItem(KEY), 10) || null; } catch (e) {}
  if (!fin) {
    fin = Date.now() + CONFIG.minutosOferta * 60000;
    try { localStorage.setItem(KEY, String(fin)); } catch (e) {}
  }
  var el = {
    badge: document.getElementById("adh-badge"),
    antes: document.getElementById("adh-antes"),
    precio: document.getElementById("adh-precio"),
    nota: document.getElementById("adh-precio-nota"),
    reloj: document.getElementById("adh-reloj"),
    relojTxt: document.getElementById("adh-reloj-txt"),
    pagar: document.getElementById("adh-pagar"),
    sinLink: document.getElementById("adh-sin-link"),
    fijaPrecio: document.getElementById("adh-fija-precio"),
    fijaTxt: document.getElementById("adh-fija-txt")
  };
  el.antes.textContent = "Antes " + CONFIG.precioNormal;
  el.badge.textContent = CONFIG.descuento;
  if (navidad) el.relojTxt.textContent = "La oferta de Navidad termina en";

  // Todos los botones (cabecera, hero, secciones, oferta, cierre y píldora) llevan directo al pago
  // y muestran el precio vigente: "Obtener por $19.990" mientras corre el contador.
  var payBtns = root.querySelectorAll("[data-pay]");
  var payTxt = root.querySelectorAll("[data-pay-txt]");
  var actual = { url: "", precio: "" };   // link y precio vigentes (cambian cuando termina el contador)
  var popRender = null;                   // se define abajo si hay upsells activos
  function setLink(url, precio){
    actual.url = url; actual.precio = precio;
    payBtns.forEach(function(a){ if (url) a.href = url; });
    payTxt.forEach(function(s){ s.textContent = "Obtener por " + precio; });
    if (popRender) popRender();
  }

  // Pop-up de upsells: al tocar cualquier botón de compra se abre antes de ir al pago.
  // Lo que se agrega suma su variante al link del carrito ("/cart/paquete:1,upsell:1").
  var pop = document.getElementById("adh-pop");
  var ups = pop ? pop.querySelectorAll("[data-up]") : [];
  function aNumero(p){ return parseInt(String(p).replace(/\D/g, ""), 10) || 0; }
  function aPesos(n){ return "$" + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, "."); }
  if (pop && ups.length && typeof pop.showModal === "function") {
    var popBase = document.getElementById("adh-pop-base");
    var popTotal = document.getElementById("adh-pop-total");
    var popPagar = document.getElementById("adh-pop-pagar");
    var popPagarTxt = document.getElementById("adh-pop-pagar-txt");
    popRender = function(){
      var total = aNumero(actual.precio), extra = "";
      ups.forEach(function(u){
        var on = u.querySelector("[data-up-btn]").getAttribute("aria-pressed") === "true";
        u.classList.toggle("is-on", on);
        if (on) { total += aNumero(u.getAttribute("data-precio")); extra += "," + u.getAttribute("data-variante") + ":1"; }
      });
      popBase.textContent = actual.precio;
      popTotal.textContent = aPesos(total);
      popPagarTxt.textContent = "Ir a pagar " + aPesos(total);
      if (actual.url) popPagar.href = actual.url + extra;
    };
    ups.forEach(function(u){
      var b = u.querySelector("[data-up-btn]");
      b.addEventListener("click", function(){
        var on = b.getAttribute("aria-pressed") !== "true";
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.textContent = on ? "✓ Agregado" : "+ Agregar";
        popRender();
      });
    });
    payBtns.forEach(function(a){
      a.addEventListener("click", function(e){
        if (!actual.url) return;
        e.preventDefault();
        popRender();
        pop.showModal();
        document.documentElement.style.overflow = "hidden";
      });
    });
    pop.addEventListener("close", function(){ document.documentElement.style.overflow = ""; });
    pop.querySelectorAll("[data-pop-cerrar]").forEach(function(b){ b.addEventListener("click", function(){ pop.close(); }); });
    pop.addEventListener("click", function(e){ if (e.target === pop) pop.close(); }); // tocar afuera cierra
  }
  var timer;
  function tick(){
    var ms = fin - Date.now();
    if (ms <= 0) {
      clearInterval(timer);
      el.badge.hidden = true; el.antes.hidden = true;
      el.precio.textContent = CONFIG.precioNormal;
      el.relojTxt.textContent = navidad ? "La oferta de Navidad terminó." : "El precio de lanzamiento terminó.";
      el.reloj.hidden = true;
      el.fijaPrecio.textContent = CONFIG.precioNormal;
      el.fijaTxt.textContent = "Precio regular";
      setLink(CONFIG.linkDePagoNormal, CONFIG.precioNormal);
      return;
    }
    var s = Math.ceil(ms / 1000), m = Math.floor(s / 60), r = s % 60;
    var t = (m < 10 ? "0" : "") + m + ":" + (r < 10 ? "0" : "") + r;
    el.precio.textContent = CONFIG.precioLanzamiento;
    el.reloj.textContent = t;
    el.fijaPrecio.textContent = CONFIG.precioLanzamiento;
    el.fijaTxt.textContent = "Termina en " + t;
  }
  setLink(CONFIG.linkDePago, CONFIG.precioLanzamiento);
  tick();
  timer = setInterval(tick, 1000);

  // Bonos: el cartel "Gratis hoy" salta cuando cada recuadro entra en pantalla.
  var bonos = root.querySelectorAll(".adh-bono");
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } });
    }, { threshold: 0.4 });
    bonos.forEach(function(b){ io.observe(b); });
  } else {
    bonos.forEach(function(b){ b.classList.add("is-visible"); });
  }

})();
</script>

